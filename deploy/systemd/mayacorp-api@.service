[Unit]
Description=MayaCorp Automações - API (%i)
After=network.target postgresql.service

[Service]
User=mayacorp
WorkingDirectory=/opt/mayacorp-automacoes/%i/backend
EnvironmentFile=/opt/mayacorp-automacoes/%i/backend/.env
ExecStart=/opt/mayacorp-automacoes/%i/backend/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port ${API_PORTA} --workers 2 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
