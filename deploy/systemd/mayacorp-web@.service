[Unit]
Description=MayaCorp Automações - Frontend Next.js (%i)
After=network.target

[Service]
User=mayacorp
WorkingDirectory=/opt/mayacorp-automacoes/%i/frontend
EnvironmentFile=/opt/mayacorp-automacoes/%i/frontend/.env.production
ExecStart=/usr/bin/npm run start -- --port ${WEB_PORTA} --hostname 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
